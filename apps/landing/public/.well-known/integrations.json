{
  "version": 3,
  "summary": "Better i18n is AI-native localization infrastructure. Agents integrate through two MCP servers — translation management (TMS) and headless CMS content — a CLI that scans source code for hardcoded strings and syncs translations, and a public translation CDN that serves per-locale JSON. Keys, translations, and localized content are managed programmatically without leaving the conversation.",
  "credentials": {
    "better_i18n_api_key": {
      "type": "api_key",
      "label": "Better i18n API key",
      "generateUrl": "https://dash.better-i18n.com/settings/api-keys",
      "setup": "Create an API key in the dashboard under Settings → API Keys. Use a secret key (sk_...) for write access. Expose it as the BETTER_I18N_API_KEY environment variable for the translation MCP server and the CLI."
    },
    "better_i18n_content_api_key": {
      "type": "api_key",
      "label": "Better i18n Content API key",
      "generateUrl": "https://dash.better-i18n.com/settings/api-keys",
      "setup": "Create an API key in the dashboard under Settings → API Keys. Expose it as the BETTER_I18N_CONTENT_API_KEY environment variable for the content MCP server."
    },
    "better_i18n_oauth": {
      "type": "oauth2",
      "label": "Better i18n OAuth",
      "generateUrl": "https://dash.better-i18n.com/settings/api-keys",
      "setup": "The hosted MCP server at https://mcp.better-i18n.com/mcp is protected by OAuth 2.1. The protected-resource metadata and authorization server are advertised at https://mcp.better-i18n.com/.well-known/oauth-protected-resource, so MCP clients resolve and complete the flow automatically (scopes: openid, profile, email, offline_access). No manual token needed for interactive clients."
    }
  },
  "surfaces": [
