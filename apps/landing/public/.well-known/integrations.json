{
  "version": 3,
  "summary": "Better i18n is AI-native localization infrastructure: a translation-management REST API (TMS), a headless content API (CMS), a public translation CDN, two MCP servers, and a CLI that scans your codebase for hardcoded strings and syncs translations. Agents can list keys, propose and publish translations, and manage localized content without leaving the conversation.",
  "credentials": {
    "better_i18n_api_key": {
      "type": "api_key",
      "label": "Better i18n API key",
      "generateUrl": "https://dash.better-i18n.com/settings/api-keys",
      "setup": "Create an API key in the dashboard under Settings → API Keys. Use a secret key (sk_...) for write access. Send it as the X-API-Key header on REST calls, or expose it as the BETTER_I18N_API_KEY environment variable for the MCP server and CLI."
    },
    "better_i18n_content_api_key": {
      "type": "api_key",
