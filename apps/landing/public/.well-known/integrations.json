      "type": "mcp",
      "url": "https://mcp.better-i18n.com/mcp",
      "transports": ["streamable-http"],
      "docs": "https://docs.better-i18n.com/mcp",
      "basis": { "via": "declared", "source": "https://better-i18n.com/.well-known/integrations.json" },
      "auth": {
